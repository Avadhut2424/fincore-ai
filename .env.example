# ==============================================================================
# FinCore AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
SECRET_KEY=fincore_enterprise_super_secret_key_change_in_production

# Database Configuration
# Default: SQLite file database
DATABASE_URL=sqlite:///fincore_warehouse.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://fincore_user:fincore_pass@localhost:5432/fincore_db

# Machine Learning Engine Configuration
ML_ESTIMATORS=100
ML_RANDOM_STATE=42
SYNTHETIC_DATA_SIZE=500

# Frontend Configuration
VITE_API_URL=http://localhost:8000
